{
  "name": "resume",
  "version": "2.0.0",
  "description": "Alan Ning's resume",
  "type": "module",
  "scripts": {
    "validate": "resumed validate resume.json",
    "build:html": "resumed render resume.json -t jsonresume-theme-even -o index.html",
    "build:pdf": "resumed export resume.json -t jsonresume-theme-even -o gen/resume.pdf",
    "build": "npm run build:html && npm run build:pdf"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/askldjd/resume.git"
  },
  "author": "Alan Ning",
  "bugs": {
    "url": "https://github.com/askldjd/resume/issues"
  },
  "homepage": "https://github.com/askldjd/resume#readme",
  "dependencies": {
    "jsonresume-theme-even": "^0.26.1",
    "jsonresume-theme-onepage": "^0.0.3",
    "puppeteer": "^24.40.0",
    "resumed": "^6.1.0"
  }
}
